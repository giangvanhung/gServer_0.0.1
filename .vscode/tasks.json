{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "build WCF",
      "type": "shell",
      "command": "& 'C:\\Program Files\\Microsoft Visual Studio\\2022\\Community\\MSBuild\\Current\\Bin\\MSBuild.exe' '${workspaceFolder}\\gServer_0.0.1\\gServer_0.0.1.csproj' /p:Configuration=Debug /p:Platform=AnyCPU /v:m",
      "problemMatcher": "$msCompile",
      "group": "build"
    },
    {
      "label": "run WCF (IIS Express)",
      "type": "shell",
      "command": "& 'C:\\Program Files\\IIS Express\\iisexpress.exe' /path:'${workspaceFolder}\\gServer_0.0.1' /port:52106",
      "isBackground": true,
      "dependsOn": "build WCF",
      "problemMatcher": {
        "pattern": { "regexp": "." },
        "background": {
          "activeOnStart": true,
          "beginsPattern": "Starting IIS Express",
          "endsPattern": "IIS Express is running"
        }
      }
    },
    {
      "label": "extjs: dev server",
      "type": "npm",
      "script": "start",
      "path": "gClient_ExtJS/g-client",
      "isBackground": true,
      "problemMatcher": {
        "owner": "webpack",
        "pattern": { "regexp": "." },
        "background": {
          "activeOnStart": true,
          "beginsPattern": "Compiling|Project is running",
          "endsPattern": "compiled successfully|Compiled successfully|webpack compiled"
        }
      }
    },
    {
      "label": "mkdocs: serve",
      "type": "shell",
      "command": "mkdocs serve",
      "options": { "cwd": "${workspaceFolder}/gServer_Introduction" },
      "isBackground": true,
      "problemMatcher": []
    }
  ]
}
